# Copy to .env (never commit .env). All variables are optional.

# Local model directory, or a Hugging Face Hub repo id (downloaded on first run).
# Default: ./models/t5-semantic-parser-final if present, else benk-007/t5-small-os-commands
VOA_MODEL_DIR=

# Sandbox directory: every file operation is confined to it. Default: ~/safe_workspace
VOA_WORKSPACE=

# Below this confidence, the agent asks for confirmation instead of acting. Default: 0.85
VOA_CONF_THRESHOLD=0.85
